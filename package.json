{
  "type": "module",
  "name": "minecraft-fractal",
  "version": "2.0.0",
  "description": "Infinite zoom fractal Minecraft texture viewer",
  "main": "src/app.js",
  "scripts": {
    "build:process-textures": "node scripts/process-textures.js",
    "build:lut": "node scripts/generate-lut.js",
    "build:atlas": "node scripts/build-atlas.js",
    "build:js": "npx esbuild src/app.js --bundle --outfile=dist/app.js --format=esm --sourcemap",
    "build": "node scripts/build.js",
    "dev": "npx esbuild src/app.js --bundle --outfile=dist/app.js --format=esm --watch --servedir=.",
    "serve": "npx serve .",
    "start": "npm run build && npm run serve",
    "process": "node process.js"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "fast-average-color-node": "^3.2.0",
    "pixi.js": "^8.6.6",
    "pureimage": "^0.4.18"
  },
  "devDependencies": {
    "esbuild": "^0.24.2",
    "serve": "^14.2.4",
    "sharp": "^0.33.5"
  }
}
